# ==============================================================================
# CAMPUSNOTES AI - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# FILE STORAGE CONFIGURATION (Phase 2: PDF Notes Storage)
# ------------------------------------------------------------------------------
# Choose storage driver: "s3" (Supabase Storage / AWS S3 / Cloudflare R2) or "local" (Local disk fallback)
STORAGE_DRIVER=local

# S3-Compatible Object Storage Credentials
# If using Supabase Storage:
# - S3_ENDPOINT: https://<project-ref>.supabase.co/storage/v1/s3
# - S3_REGION: ap-south-1 (or your Supabase project region)
# - S3_BUCKET: campus-notes
# - S3_ACCESS_KEY_ID: Found in Supabase Project Settings -> Storage -> S3 Access Keys
# - S3_SECRET_ACCESS_KEY: Found in Supabase Project Settings -> Storage -> S3 Access Keys
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=campus-notes
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.6-flash
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45
